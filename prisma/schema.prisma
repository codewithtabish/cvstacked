generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum ResumePurchaseProduct {
  RESUME
  AI_OPTIMIZER
}

enum ResumePurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum ResumeAIOptimizerStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// USER
// ============================================================

model User {
  id       String  @id @default(cuid())
  clerkId  String  @unique
  fullName String?

  resumes            Resume[]
  resumeAIOptimizers ResumeAIOptimizer[]
  purchases          ResumePurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// NORMAL RESUME
//
// Created directly inside the CVStacked resume builder.
//
// Price: $3 one-time
// ============================================================

model Resume {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  resumeTemplateId String
  content          Json

  purchases ResumePurchase[] @relation("ResumePurchases")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A user can have many resumes,
  // but cannot have the same template twice.
  @@unique([userId, resumeTemplateId])
  @@index([userId])
  @@index([resumeTemplateId])
}

// ============================================================
// AI RESUME OPTIMIZER
//
// User uploads an existing resume and can provide:
// - Job URL
// - Custom instructions/prompt
//
// CVStacked extracts the job information and uses AI
// to optimize/tailor the resume.
//
// Price: $4 one-time
// ============================================================

model ResumeAIOptimizer {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  fileUrl  String?
  fileType String?
  fileSize Int?

  sourceContent Json

  processingPrompt String?
  jobUrl           String?
  jobData          Json?

  optimizedContent Json?

  processingStatus ResumeAIOptimizerStatus @default(PENDING)

  purchases ResumePurchase[] @relation("AIOptimizerPurchases")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([processingStatus])
}

// ============================================================
// ONE-TIME PURCHASE
//
// Normal Resume:
//   $3 USD
//
// AI Resume Optimizer:
//   $4 USD
//
// No subscriptions.
// ============================================================

model ResumePurchase {
  id String @id @default(cuid())

  // ----------------------------------------------------------
  // User
  // ----------------------------------------------------------

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ----------------------------------------------------------
  // Normal Resume
  // ----------------------------------------------------------

  resumeId String?
  resume   Resume? @relation("ResumePurchases", fields: [resumeId], references: [id], onDelete: Cascade)

  // ----------------------------------------------------------
  // AI Resume Optimizer
  // ----------------------------------------------------------

  resumeAIOptimizerId String?
  resumeAIOptimizer   ResumeAIOptimizer? @relation("AIOptimizerPurchases", fields: [resumeAIOptimizerId], references: [id], onDelete: Cascade)

  // ----------------------------------------------------------
  // Product
  // ----------------------------------------------------------

  productType ResumePurchaseProduct

  // ----------------------------------------------------------
  // Payment provider
  // ----------------------------------------------------------

  provider String @default("safepay")

  tracker String @unique

  paymentId String?

  // ----------------------------------------------------------
  // Payment amount
  //
  // Resume:
  // $3.00 = 300
  //
  // AI Optimizer:
  // $4.00 = 400
  //
  // Stored in cents.
  // ----------------------------------------------------------

  amount   Int
  currency String @default("USD")

  // ----------------------------------------------------------
  // Payment status
  // ----------------------------------------------------------

  status ResumePurchaseStatus @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([resumeId])
  @@index([resumeAIOptimizerId])
  @@index([productType])
  @@index([status])
  @@index([paymentId])
}

// ============================================================
// PAYMENT EVENTS
//
// Stores Safepay webhook events.
//
// Used for:
// - webhook auditing
// - debugging
// - idempotency
// - payment history
// ============================================================

model PaymentEvent {
  id String @id @default(cuid())

  provider String @default("safepay")

  eventId String?

  eventType String?

  tracker String?

  payload Json

  createdAt DateTime @default(now())

  @@index([provider])
  @@index([eventId])
  @@index([eventType])
  @@index([tracker])
}
